# gfem matplotlib style (light), applied by `just notebooks` only (docs/_ext/gfem_figures.py).
# Values are the site's colour tokens (docs/_static/gfem.css). Series take categorical hues
# (blue, orange, aqua, yellow, magenta, violet; checked for colour-vision deficiency on the
# light ground) and a line style each, so no plot relies on hue alone. No series is green
# (the FD-verified status) or red (the signal red is reserved for the sensitivity colormap).
# docs/_ext/gfem_figures.py pairs every colour here with the same key in gfem-dark.mplstyle.
font.family: Barlow, DejaVu Sans
font.size: 10.5
axes.titlesize: 11
axes.titleweight: semibold  # the site's titles are 500; the Barlow TTFs ship 400 and 600
axes.titlelocation: left
axes.labelsize: 10.5
axes.labelcolor: 3d3d3d
axes.edgecolor: 9a9a96
axes.linewidth: 0.7
axes.spines.top: False
axes.spines.right: False
axes.grid: True
grid.color: dcdcdc
grid.linewidth: 0.6
axes.prop_cycle: cycler('color', ['2a78d6', 'eb6834', '1baf7a', 'eda100', 'e87ba4', '6250d6']) + cycler('linestyle', ['-', '--', ':', '-.', '-', '--'])
lines.linewidth: 1.5
patch.edgecolor: 262626
xtick.color: 6b6b6b
ytick.color: 6b6b6b
xtick.labelsize: 9.5
ytick.labelsize: 9.5
xtick.major.size: 3
ytick.major.size: 3
legend.frameon: False
legend.edgecolor: dcdcdc
legend.fontsize: 9.5
figure.facecolor: none
figure.edgecolor: none
axes.facecolor: none
savefig.facecolor: none
savefig.transparent: True
text.color: 262626
figure.dpi: 150
